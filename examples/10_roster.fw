# World Roster and Counters
# Brings 5 creatures of 3 different types to life, then prints them by category.
# Secretly teaches: typed collections, filtering by category.

creature Human
  when born with (name)
    give self the trait name to name
  end born
end creature

creature Elf
  when born with (name)
    give self the trait name to name
  end born
end creature

creature Dwarf
  when born with (name)
    give self the trait name to name
  end born
end creature

# Bring 5 creatures of 3 different types to life
bring Alice to life as Human with ("Alice")
bring Bob to life as Human with ("Bob")
bring Legolas to life as Elf with ("Legolas")
bring Gimli to life as Dwarf with ("Gimli")
bring Thorin to life as Dwarf with ("Thorin")

say "--- Humans in the World ---"
repeat through the world's Human creatures as each_human
  say "  " + each_human name
end repeat

say "--- Elves in the World ---"
repeat through the world's Elf creatures as each_elf
  say "  " + each_elf name
end repeat

say "--- Dwarves in the World ---"
repeat through the world's Dwarf creatures as each_dwarf
  say "  " + each_dwarf name
end repeat

say "--- Counts ---"
say "There are " + the world counts Human + " humans."
say "There are " + the world counts Elf + " elves."
say "There are " + the world counts Dwarf + " dwarves."
