{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ForWhile",
  "scopeName": "source.fw",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fw",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fw",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fw",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fw",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.fw",
          "match": "(?i)\\b(yes|no|true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.creature.fw",
          "match": "\\b(creature|from|traits|action|born|with)\\b"
        },
        {
          "name": "keyword.control.flow.fw",
          "match": "\\b(when|otherwise|end|repeat|times|through|as|whenever|anyone|gets|changed)\\b"
        },
        {
          "name": "keyword.other.world.fw",
          "match": "\\b(the|world|world's|creatures|counts|remembers|knows|forgets|strict|lenient)\\b"
        },
        {
          "name": "keyword.other.verbs.fw",
          "match": "\\b(set|to|give|trait|does|call|remove|from|announce|ask|save|restore|attach|scene|play|on|each|tick|ticks)\\b"
        },
        {
          "name": "keyword.other.kinds.fw",
          "match": "\\b(word|number|between|and|one|of|list|is|a|an)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.fw",
          "match": "==|!=|<|>|\\b(is)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.fw",
          "match": "\\+|-|\\*"
        }
      ]
    }
  }
}
