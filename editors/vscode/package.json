{
  "name": "forwhile-vscode",
  "displayName": "ForWhile Storytelling Programming Language",
  "description": "Syntax highlighting support for the ForWhile world-building programming language",
  "version": "1.0.1",
  "publisher": "forwhile",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "forwhile",
      "aliases": ["ForWhile", "forwhile"],
      "extensions": [".fw"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "forwhile",
      "scopeName": "source.fw",
      "path": "./syntaxes/forwhile.tmLanguage.json"
    }]
  }
}
